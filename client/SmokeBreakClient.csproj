<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SmokeBreakClient</AssemblyName>
    <RootNamespace>SmokeBreakClient</RootNamespace>
    <Version>0.3.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DeployToSPT Condition="'$(DeployToSPT)' == ''">false</DeployToSPT>
  </PropertyGroup>

  <PropertyGroup>
    <SPTPath Condition="'$(SPTPath)' == ''">$(SPT_PATH)</SPTPath>
    <SPTPath Condition="'$(SPTPath)' != ''">$(SPTPath.TrimEnd('\'))</SPTPath>
    <SPTManagedPath>$(SPTPath)\EscapeFromTarkov_Data\Managed</SPTManagedPath>
    <SPTBepInExPath>$(SPTPath)\BepInEx</SPTBepInExPath>
  </PropertyGroup>

  <Target Name="ValidateSPTPath" BeforeTargets="BeforeBuild">
    <Error Condition="'$(SPTPath)' == ''" Text="SPTPath is not set. e.g. -p:SPTPath=H:\SPT4.1.X" />
    <Error Condition="!Exists('$(SPTManagedPath)\Assembly-CSharp.dll')" Text="SPTPath ('$(SPTPath)') is not an SPT install root." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(SPTBepInExPath)\core\BepInEx.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SPTBepInExPath)\core\0Harmony.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(SPTManagedPath)\Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Comfort"><HintPath>$(SPTManagedPath)\Comfort.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(SPTManagedPath)\UnityEngine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(SPTManagedPath)\UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(SPTManagedPath)\UnityEngine.AssetBundleModule.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <Target Name="DeployToSPT" AfterTargets="Build" Condition="'$(DeployToSPT)' == 'true'">
    <PropertyGroup>
      <PluginDir>$(SPTBepInExPath)\plugins\SmokeBreak</PluginDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginDir)\bundles" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
    <ItemGroup>
      <ClientBundles Include="$(MSBuildProjectDirectory)\..\bundles\smokebreak\*.bundle" />
    </ItemGroup>
    <Copy SourceFiles="@(ClientBundles)" DestinationFolder="$(PluginDir)\bundles" />
  </Target>
</Project>
